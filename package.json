{
  "name": "@ecarrizo2/wardenauthz-js",
  "version": "0.2.0",
  "description": "TypeScript SDK for WardenAuthz managed authorization API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "bin": {
    "ec-warden-auth": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/**/*.test.js",
    "codegen:types": "openapi-typescript openapi.yaml -o src/types/openapi-generated.ts"
  },
  "keywords": [
    "wardenauthz",
    "authorization",
    "multi-tenant",
    "permissions",
    "rbac"
  ],
  "homepage": "https://wardenauthz.com",
  "dependencies": {
    "js-yaml": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24",
    "typescript": "^5.0.0 || ^6.0.0",
    "openapi-typescript": "^7"
  },
  "license": "SEE LICENSE IN LICENSE"
}
